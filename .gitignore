# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo
.next/
out/

# Quarry scratch space: clones, stage artifacts, generated packages, zips.
# Never commit anything under here.
work/

# test / tooling output
coverage/
.vitest/
*.log
npm-debug.log*
pnpm-debug.log*

# secrets — never commit, and never feed to an agent (CLAUDE.md invariant 2)
.env
.env.*
!.env.example

# ...except inside the ingest fixture, which ships a deliberately fake .env so the
# secret-stripping tests have something to strip. It grants access to nothing.
!packages/core/test/fixtures/**/.env
!packages/core/test/fixtures/**/.env.*
*.pem
*.key
id_rsa*

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Next.js build output and its generated ambient types.
apps/web/.next/
apps/web/next-env.d.ts
